# Halium 12 kernel config fragment for beyondx (Samsung Galaxy S10 5G, exynos9820)
# Base: LineageOS android_kernel_samsung_exynos9820, branch lineage-19.1 (kernel 4.14).
#
# Apply on top of the stock Lineage defconfig:
#   make ARCH=arm64 exynos9820-beyondx_defconfig
#   scripts/kconfig/merge_config.sh -m -O out \
#       arch/arm64/configs/exynos9820-beyondx_defconfig \
#       halium_beyondx_frag.config
#   (then: make ARCH=arm64 O=out olddefconfig)
#
# Verified against the resolved beyondx .config on 2026-11-19:
#   - Samsung security blockers (DEFEX/PROCA/FIVE/RKP/KDP/UH) are ALREADY off in Lineage.
#   - Binder+hwbinder, cgroups, namespaces, FUSE, ashmem: already y.
#   - IPsec/crypto for IMS (ESP, XFRM transport+tunnel, AES/SHA*/HMAC/DES/CBC/AUTHENC,
#     NET_KEY/PF_KEY): already y. Nothing to add there.
# So the only gaps are the Halium/systemd/lxc boot essentials below.

# --- Mandatory for a Halium userspace to boot (systemd + lxc-android + udev) ---
CONFIG_SYSVIPC=y
CONFIG_FHANDLE=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
# Leave FRAMEBUFFER_CONSOLE OFF on purpose: hwcomposer/libhybris owns the display;
# fbcon fighting it is a known cause of a black screen on Exynos Halium ports.

# --- Flagged "ERROR" by mer-kernel-check; not boot-critical here, but enable for
#     parity with other UT/Droidian ports and for connman/VPN features ---
CONFIG_INET_AH=y
CONFIG_INET_IPCOMP=y
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=y
CONFIG_L2TP_IP=y
CONFIG_L2TP_V3=y

# --- Ubuntu Touch app confinement. OPTIONAL for first boot. If enabled, also make
#     sure the LSM list/cmdline allows it (4.14 stacks selinux+apparmor); UT runs
#     SELinux permissive via the androidboot cmdline. Enable once the base boots. ---
# CONFIG_SECURITY_APPARMOR=y
